# Copy to .env and fill in. NEVER commit real secrets.
# Create an OAuth client (Desktop app) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Enable APIs:
# - Google Drive API
# - Google Photos Picker API
# - (optional legacy) Photos Library API — library-wide read is restricted since 2025

GOOGLE_OAUTH_CLIENT_SECRETS=./credentials/client_secret.json
GOOGLE_TOKEN_PATH=./credentials/token.json

# Drive: folder ID from the URL when you open the folder
# https://drive.google.com/drive/folders/<FOLDER_ID>
BRIDGE_DRIVE_FOLDER_ID=

# Or match folder name under My Drive (slower; first match wins)
BRIDGE_DRIVE_FOLDER_NAME=Morgelon Inspiration

# Local drop / Google Takeout unpack path (always watched)
BRIDGE_WATCH_DIR=../cinematic/assets/plates/inbox

# Where inspiration lands for the game/cinematic
BRIDGE_OUT_DIR=../cinematic/assets/plates/inspiration

# Polling
BRIDGE_POLL_SECONDS=120
BRIDGE_PHOTOS_POLL_SECONDS=3

# Optional: rclone remote names if you use rclone instead/in addition
# rclone config → create "gdrive" and/or "gphotos" remotes
BRIDGE_RCLONE_GDRIVE=
BRIDGE_RCLONE_GPHOTOS=
BRIDGE_RCLONE_PATH=
